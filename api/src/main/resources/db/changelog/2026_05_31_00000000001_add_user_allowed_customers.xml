<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="2026_05_31_00000000001_add_user_allowed_customers" author="codex">
        <createTable tableName="own_user_allowed_customers">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="own_user_allowed_customers"
                       columnNames="user_id, customer_id"
                       constraintName="pk_own_user_allowed_customers"/>

        <addForeignKeyConstraint baseTableName="own_user_allowed_customers"
                                 baseColumnNames="user_id"
                                 constraintName="fk_own_user_allowed_customers_user"
                                 referencedTableName="own_user"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="own_user_allowed_customers"
                                 baseColumnNames="customer_id"
                                 constraintName="fk_own_user_allowed_customers_customer"
                                 referencedTableName="customer"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
