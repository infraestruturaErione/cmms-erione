<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026_05_25_00000000001_add_user_customers" author="erione">
        <createTable tableName="user_customers">
            <column name="user_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_user_customers_user" references="own_user(id)"/>
            </column>
            <column name="customer_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_user_customers_customer" references="customer(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_customers" columnNames="user_id, customer_id"/>
    </changeSet>

</databaseChangeLog>
