<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Cidade do cliente: usada pra agrupar/filtrar OS no relatorio em massa
         por cidade + periodo. Nao existia campo estruturado antes - a cidade
         so aparecia embutida em texto livre dentro do endereco. -->
    <changeSet id="20260805-01-add-customer-city" author="claude">
        <sql>
            ALTER TABLE customer ADD COLUMN IF NOT EXISTS city VARCHAR(255);
        </sql>
        <rollback>
            ALTER TABLE customer DROP COLUMN IF EXISTS city;
        </rollback>
    </changeSet>

</databaseChangeLog>
