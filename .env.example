# Gerenciamento de webhooks (/webhook-endpoints). MANTER false na Erione ate tratar: PATCH parcial, categorias de outra empresa, SSRF do envio.
WEBHOOK_MANAGEMENT_ENABLED=false

# IP do cliente para o rate limit de login. 1 = so' o nginx do frontend na frente do backend (DEV).
# Com uma borda (ex.: OpenResty) que ACRESCENTA o IP do cliente ao X-Forwarded-For, use 2.
# Errar para menos e' seguro (todos dividem o balde do proxy); para mais permite forjar o IP.
TRUSTED_PROXY_HOPS=1
